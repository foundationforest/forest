{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/carrier/Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/xrpc/_health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}
