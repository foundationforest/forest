{
  "name": "@forest/records",
  "version": "0.0.0",
  "private": true,
  "description": "Forest records: signed records on open hosts. The core library, a reference host, private records, the record schemas, tests and vectors. Nothing is shipped.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./private": {
      "types": "./dist/private.d.ts",
      "default": "./dist/private.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "bench": "node bench/throughput.ts"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "age-encryption": "0.3.1",
    "canonicalize": "5.1.0"
  },
  "devDependencies": {
    "@solana/transaction-messages": "8.4.0",
    "@types/node": "22.20.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  }
}
