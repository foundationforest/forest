{
  "name": "@forest/records",
  "version": "0.0.0",
  "private": true,
  "description": "Forest records: signed entries on plain hosts. The spec, the core library, a reference host, a reference approval page, the record schemas, tests and vectors. Nothing is shipped.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./indexer": {
      "types": "./dist/indexer.d.ts",
      "default": "./dist/indexer.js"
    },
    "./sealed": {
      "types": "./dist/sealed.d.ts",
      "default": "./dist/sealed.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "default": "./dist/discovery.js"
    },
    "./connections": {
      "types": "./dist/connections.d.ts",
      "default": "./dist/connections.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "SPEC.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:fast": "node --test test/core.test.ts test/view.test.ts test/host.test.ts test/grants.test.ts test/sealed.test.ts test/attacks.test.ts",
    "test:net": "node --test test/net/*.test.ts",
    "build:page": "node web/build.ts",
    "bench": "node bench/throughput.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@synonymdev/pkarr": "8.0.2",
    "age-encryption": "0.3.1",
    "canonicalize": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@solana/transaction-messages": "8.4.0",
    "@types/node": "22.20.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  }
}
