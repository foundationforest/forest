{
  "name": "@forest/keys",
  "version": "0.0.0",
  "private": true,
  "description": "Forest keys recipe: passkey secret to seed, seed to each profile's key (its name, signature and wallet) and box key, one identity and one central wallet per person, the seed file for extra passkeys, and paper export.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:page": "esbuild src/index.ts --bundle --format=esm --platform=browser --outfile=test-page/dist/forest-keys.js"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@semaphore-protocol/identity": "4.12.1",
    "age-encryption": "0.3.1"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@types/node": "22.20.2",
    "@zk-kit/baby-jubjub": "1.0.3",
    "esbuild": "0.28.2",
    "poseidon-lite": "0.3.0",
    "typescript": "5.9.3"
  }
}
