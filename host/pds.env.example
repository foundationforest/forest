# The Forest host's configuration. Copy to host/pds.env. Everything the reference PDS reads
# is listed in upstream/packages/pds/src/config/env.ts; these are the ones that matter here.

# Where the host is reached. `localhost` makes the public URL http://localhost:PDS_PORT; any
# other hostname makes it https://PDS_HOSTNAME. A folder's DID document must point at exactly
# this URL for the host to make the folder.
PDS_HOSTNAME=localhost
PDS_PORT=2583

# Plain SQLite files, and a folder for photos. One volume holds both.
PDS_DATA_DIRECTORY=./data
PDS_BLOBSTORE_DISK_LOCATION=./data/blobs

# The directory of DIDs. A local one for tests; the public one otherwise.
PDS_DID_PLC_URL=https://plc.directory

# The host's own secrets. None of them is ever an account's key: folders are signed on the
# device and this host holds no key for any of them. Generate each with `openssl rand -hex 32`.
# PDS_PLC_ROTATION_KEY is the host's rotation key for DIDs it would create through the
# reference signup path; no Forest DID contains it, but upstream's config requires it.
PDS_JWT_SECRET=replace-me
PDS_ADMIN_PASSWORD=replace-me
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=replace-me

# Upstream's own signup path stays in the code but is closed: no invites are issued.
PDS_INVITE_REQUIRED=1

# The Bluesky app view is not part of Forest. Upstream requires the setting.
PDS_BSKY_APP_VIEW_URL=https://appview.invalid
PDS_BSKY_APP_VIEW_DID=did:web:appview.invalid

# Logs: on, and with no client address in them (see README, "No address logs").
LOG_ENABLED=1
LOG_LEVEL=info

# On localhost, over plain http, upstream's OAuth provider needs dev mode; a real hostname is https and
# does not. Dev mode also turns off the SSRF guard on outbound requests, so never set it on a public host.
PDS_DEV_MODE=1
