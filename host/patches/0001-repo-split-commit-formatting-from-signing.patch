+  ): Promise<UnsignedCommitData> {
     const newBlocks = new BlockMap()
 
     let data = await MST.create(storage)
@@ -54,19 +59,14 @@ export class Repo extends ReadableRepo {
     newBlocks.addMap(diff.newMstBlocks)
 
     const rev = revOverride ?? TID.nextStr()
-    const commit = await util.signCommit(
-      {
+    return {
+      unsigned: {
         did,
         version: 3,
         rev,
         prev: null, // added for backwards compatibility with v2
         data: dataCid,
       },
-      keypair,
-    )
-    const commitCid = await newBlocks.add(commit)
-    return {
-      cid: commitCid,
       rev,
       since: null,
       prev: null,
@@ -76,6 +76,54 @@ export class Repo extends ReadableRepo {
     }
   }
 
+  static async formatInitCommit(
+    storage: RepoStorage,
+    did: string,
+    keypair: crypto.Keypair,
+    initialWrites: RecordCreateOp[] = [],
+    revOverride?: string,
+  ): Promise<CommitData> {
+    const unsigned = await Repo.formatUnsignedInitCommit(
+      storage,
+      did,
+      initialWrites,
+      revOverride,
+    )
+    const commit = await util.signCommit(unsigned.unsigned, keypair)
+    return Repo.finalizeCommit(unsigned, commit)
+  }
+
+  /**
+   * Attach a signed commit to what `formatUnsignedCommit` or `formatUnsignedInitCommit`
+   * produced: encode it, add its block, and name the previous commit's block as removed when
+   * there was one. The signature itself is not checked here; `verifyCommitSig` is for that.
+   */
+  static async finalizeCommit(
+    unsigned: UnsignedCommitData,
+    commit: Commit,
+  ): Promise<CommitData> {
+    const commitBytes = encode(commit)
+    const commitCid = await cidForCbor(commitBytes)
+
+    if (unsigned.prev === null || !commitCid.equals(unsigned.prev)) {
+      unsigned.newBlocks.set(commitCid, commitBytes)
+      unsigned.relevantBlocks.set(commitCid, commitBytes)
+      if (unsigned.prev !== null) {
+        unsigned.removedCids.add(unsigned.prev)
+      }
+    }
+
+    return {
+      cid: commitCid,
+      rev: unsigned.rev,
+      since: unsigned.since,
+      prev: unsigned.prev,
+      newBlocks: unsigned.newBlocks,
+      relevantBlocks: unsigned.relevantBlocks,
+      removedCids: unsigned.removedCids,
+    }
+  }
+
   static async createFromCommit(
     storage: RepoStorage,
     commit: CommitData,
@@ -115,10 +163,15 @@ export class Repo extends ReadableRepo {
     })
   }
 
-  async formatCommit(
+  /**
