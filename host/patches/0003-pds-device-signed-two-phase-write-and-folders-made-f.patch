diff --git a/packages/pds/src/api/foundation/forest/host/prepareCommit.ts b/packages/pds/src/api/foundation/forest/host/prepareCommit.ts
new file mode 100644
index 0000000..21dba53
--- /dev/null
+++ b/packages/pds/src/api/foundation/forest/host/prepareCommit.ts
@@ -0,0 +1,78 @@
+import { isDidString } from '@atproto/lex'
+import { encode } from '@atproto/lex-cbor'
+import { parseCid } from '@atproto/lex-data'
+import { InvalidRequestError, type Server } from '@atproto/xrpc-server'
+import type { UnsignedCommitWithOps } from '../../../../actor-store/repo/transactor.js'
+import type { AppContext } from '../../../../context.js'
+import { foundation } from '../../../../lexicons/index.js'
+import {
+  asRequestError,
+  assertFolderCanBeMadeHere,
+  ensureCreates,
+  prepareWrites,
+  unsignedGenesis,
+  writeToResult,
+  writeWithKey,
+} from './util.js'
+
+export default function (server: Server, ctx: AppContext) {
+  server.add(foundation.forest.host.prepareCommit, {
+    // The device's own signature over a service token: issuer the folder's DID, audience this
+    // host, method this one. Verified against the DID document's signing key. No session.
+    auth: ctx.authVerifier.userServiceAuth,
+    opts: {
+      jsonLimit: 1_000_000,
+    },
+    handler: async ({ input, auth }) => {
+      const did = auth.credentials.did
+      if (!isDidString(did)) {
+        throw new InvalidRequestError('Not a DID', 'InvalidRequest')
+      }
+      const { writes, validate, swapCommit } = input.body
+
+      const genesis = !(await ctx.actorStore.exists(did))
+      const prepared = await prepareWrites(did, writes, validate, {
+        requireRkey: false,
+      })
+
+      let unsigned: UnsignedCommitWithOps
+      if (genesis) {
+        if (swapCommit) {
+          throw new InvalidRequestError(
+            'A genesis commit builds on nothing: omit swapCommit',
+            'InvalidSwap',
+          )
+        }
+        await assertFolderCanBeMadeHere(ctx, did)
+        unsigned = await unsignedGenesis(did, ensureCreates(prepared))
+      } else {
+        await ctx.authVerifier.findAccount(did, {
+          checkDeactivated: true,
+          checkTakedown: true,
+        })
+        const swapCommitCid = swapCommit ? parseCid(swapCommit) : undefined
+        unsigned = await ctx.actorStore
+          .transact(did, (actorTxn) =>
+            actorTxn.repo.formatUnsignedCommit(prepared, swapCommitCid),
+          )
+          .catch(asRequestError)
+      }
+
+      return {
+        encoding: 'application/json' as const,
+        body: {
+          did,
+          genesis,
+          rev: unsigned.rev,
+          prev: unsigned.prev?.toString(),
+          since: unsigned.since ?? undefined,
+          data: unsigned.unsigned.data.toString(),
+          // Exactly what `signCommit` would have signed, and what `verifyCommitSig` checks.
+          unsignedCommit: encode(unsigned.unsigned),
+          writes: prepared.map(writeWithKey),
+          results: prepared.map(writeToResult),
+        },
+      }
+    },
+  })
+}
