 }
+
+/** A device-signed commit whose rev is not a TID newer than the current head's. */
+export class BadCommitRevError extends Error {
+  constructor(
+    public rev: string,
+    public headRev: string | null,
+  ) {
+    super(
+      headRev === null
+        ? `Rev ${rev} is not a valid TID`
+        : `Rev ${rev} is not newer than the current head's rev ${headRev}`,
+    )
+  }
+}
+
+/**
+ * A device-signed commit whose signature does not verify, against the DID document's signing
+ * key, over the commit the host rebuilt from the writes and rev it was given.
+ */
+export class BadCommitSignatureError extends Error {
+  constructor() {
+    super(
+      'Signature does not verify over the rebuilt commit: either another key signed it, or the head moved since it was prepared',
+    )
+  }
+}
