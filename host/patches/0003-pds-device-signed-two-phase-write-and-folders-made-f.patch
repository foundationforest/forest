+import { dbLogger } from '../../../../logger.js'
+import type { CommitDataWithOps } from '../../../../repo/index.js'
+import {
+  asRequestError,
+  assertFolderCanBeMadeHere,
+  createFolder,
+  ensureCreates,
+  prepareWrites,
+  withDeviceKey,
+  writeToResult,
+} from './util.js'
+
+const ratelimitPoints = ({
+  input,
+}: {
+  input: foundation.forest.host.submitCommit.$Input
+}) => {
+  let points = 0
+  for (const op of input.body.writes) {
+    if (com.atproto.repo.applyWrites.create.$isTypeOf(op)) {
+      points += 3
+    } else if (com.atproto.repo.applyWrites.update.$isTypeOf(op)) {
+      points += 2
+    } else {
+      points += 1
+    }
+  }
+  return points
+}
+
+export default function (server: Server, ctx: AppContext) {
+  server.add(foundation.forest.host.submitCommit, {
+    auth: ctx.authVerifier.userServiceAuth,
+    rateLimit: [
+      {
+        name: 'repo-write-hour',
+        calcKey: ({ auth }) => auth.credentials.did,
+        calcPoints: ratelimitPoints,
+      },
+      {
+        name: 'repo-write-day',
+        calcKey: ({ auth }) => auth.credentials.did,
+        calcPoints: ratelimitPoints,
+      },
+    ],
+    opts: {
+      jsonLimit: 1_000_000,
+    },
+    handler: async ({ input, auth }) => {
+      const did = auth.credentials.did
+      if (!isDidString(did)) {
+        throw new InvalidRequestError('Not a DID', 'InvalidRequest')
+      }
+      const { writes, validate, swapCommit, rev, sig } = input.body
+
+      const prepared = await prepareWrites(did, writes, validate, {
+        requireRkey: true,
+      })
+
+      const genesis = !(await ctx.actorStore.exists(did))
+      let commit: CommitDataWithOps
+      if (genesis) {
+        if (swapCommit) {
+          throw new InvalidRequestError(
+            'A genesis commit builds on nothing: omit swapCommit',
+            'InvalidSwap',
+          )
+        }
+        // The signing key comes from the document read fresh here, so a folder is only ever
+        // made for the key the directory names right now.
+        const { handle, signingKey } = await assertFolderCanBeMadeHere(ctx, did)
+        commit = await createFolder(
+          ctx,
+          did,
+          handle,
+          ensureCreates(prepared),
+          rev,
+          sig,
+          signingKey,
+        ).catch(asRequestError)
+      } else {
+        await ctx.authVerifier.findAccount(did, {
+          checkDeactivated: true,
+          checkTakedown: true,
+        })
+        const swapCommitCid = swapCommit ? parseCid(swapCommit) : undefined
+        commit = await withDeviceKey(ctx, did, (didKey) =>
+          ctx.actorStore.transact(did, async (actorTxn) => {
+            const commit = await actorTxn.repo.processDeviceSignedWrites(
+              prepared,
+              swapCommitCid,
+              rev,
+              sig,
+              didKey,
+            )
+            await ctx.sequencer.sequenceCommit(did, commit)
+            return commit
+          }),
+        ).catch(asRequestError)
+
+        await ctx.accountManager
+          .updateRepoRoot(did, commit.cid, commit.rev)
+          .catch((err) => {
+            dbLogger.error(
+              { err, did, cid: commit.cid, rev: commit.rev },
+              'failed to update account root',
+            )
+          })
+      }
+
+      return {
+        encoding: 'application/json' as const,
+        body: {
+          commit: {
+            cid: commit.cid.toString(),
+            rev: commit.rev,
+          },
+          results: prepared.map(writeToResult),
+        },
+      }
+    },
+  })
+}
diff --git a/packages/pds/src/api/foundation/forest/host/util.ts b/packages/pds/src/api/foundation/forest/host/util.ts
new file mode 100644
index 0000000..49789f5
--- /dev/null
+++ b/packages/pds/src/api/foundation/forest/host/util.ts
@@ -0,0 +1,309 @@
+// The device-signed write path, shared by prepareCommit and submitCommit.
+//
+// A Forest folder is a repo whose every commit is signed on its owner's device. The host holds
+// no key for it: it prepares commits, checks signatures against the DID document, stores, and
+// serves. Both endpoints are authenticated by a service token the device signs with the same
+// key (`userServiceAuth`), never by a password or a session.
+
+import { ensureAtpDocument } from '@atproto/identity'
+import type { DidString, HandleString } from '@atproto/lex'
+import { MemoryBlockstore, Repo, WriteOpAction, formatDataKey } from '@atproto/repo'
+import { InvalidRequestError } from '@atproto/xrpc-server'
+import type { UnsignedCommitWithOps } from '../../../../actor-store/repo/transactor.js'
+import type { AppContext } from '../../../../context.js'
+import { com, foundation } from '../../../../lexicons/index.js'
+import {
+  BadCommitRevError,
+  BadCommitSignatureError,
+  BadCommitSwapError,
+  type CommitDataWithOps,
+  InvalidRecordError,
+  type PreparedCreate,
+  type PreparedWrite,
+  createWriteToOp,
+  prepareCreate,
+  prepareDelete,
+  prepareUpdate,
+} from '../../../../repo/index.js'
+
+export type WriteInput =
+  foundation.forest.host.prepareCommit.$InputBody['writes'][number]
+
+export const MAX_WRITES = 200
+
+/**
+ * The writes as `PreparedWrite`s, exactly as `com.atproto.repo.applyWrites` prepares them. At
+ * submit time every create must carry the record key prepare assigned, or the rebuilt commit
+ * would not be the one the device signed.
+ */
+export const prepareWrites = async (
+  did: DidString,
+  writes: WriteInput[],
+  validate: boolean | undefined,
+  { requireRkey }: { requireRkey: boolean },
+): Promise<PreparedWrite[]> => {
+  if (writes.length > MAX_WRITES) {
+    throw new InvalidRequestError(`Too many writes. Max: ${MAX_WRITES}`)
+  }
+  try {
+    return await Promise.all(
+      writes.map(async (write, i) => {
+        if (com.atproto.repo.applyWrites.create.$isTypeOf(write)) {
+          if (requireRkey && !write.rkey) {
+            throw new InvalidRequestError(
+              `writes[${i}]: a create must carry the rkey prepareCommit assigned`,
+            )
+          }
+          return prepareCreate({
+            did,
+            collection: write.collection,
+            record: write.value,
+            rkey: write.rkey,
+            validate,
+            validationPath: ['writes', i, 'value'],
+          })
+        } else if (com.atproto.repo.applyWrites.update.$isTypeOf(write)) {
+          return prepareUpdate({
+            did,
+            collection: write.collection,
+            record: write.value,
+            rkey: write.rkey,
+            validate,
+            validationPath: ['writes', i, 'value'],
+          })
+        } else if (com.atproto.repo.applyWrites.delete.$isTypeOf(write)) {
+          return prepareDelete({
+            did,
+            collection: write.collection,
+            rkey: write.rkey,
+          })
+        } else {
+          throw new InvalidRequestError(
+            `Action not supported: ${write['$type']}`,
+          )
+        }
+      }),
+    )
+  } catch (err) {
+    if (err instanceof InvalidRecordError) {
+      throw new InvalidRequestError(err.message)
+    }
+    throw err
+  }
+}
+
+/** A genesis commit can only create records: there is nothing yet to update or delete. */
+export const ensureCreates = (writes: PreparedWrite[]): PreparedCreate[] => {
+  return writes.map((write) => {
+    if (write.action !== WriteOpAction.Create) {
+      throw new InvalidRequestError(
+        'A genesis commit can only create records: nothing exists yet to update or delete',
+      )
+    }
+    return write
+  })
+}
+
+/** The write as the host understood it, record key included, for the device to send back. */
+export const writeWithKey = (write: PreparedWrite): WriteInput => {
+  switch (write.action) {
+    case WriteOpAction.Create:
+      return com.atproto.repo.applyWrites.create.$build({
+        collection: write.uri.collectionSafe,
+        rkey: write.uri.rkeySafe,
+        value: write.record,
+      })
+    case WriteOpAction.Update:
+      return com.atproto.repo.applyWrites.update.$build({
+        collection: write.uri.collectionSafe,
+        rkey: write.uri.rkeySafe,
+        value: write.record,
+      })
+    case WriteOpAction.Delete:
+      return com.atproto.repo.applyWrites.delete.$build({
+        collection: write.uri.collectionSafe,
+        rkey: write.uri.rkeySafe,
+      })
+    default:
+      throw new Error(`Unrecognized action: ${write}`)
+  }
+}
+
+export const writeToResult = (write: PreparedWrite) => {
+  switch (write.action) {
+    case WriteOpAction.Create:
+      return com.atproto.repo.applyWrites.createResult.$build({
+        cid: write.cid.toString(),
+        uri: write.uri.toString(),
+        validationStatus: write.validationStatus,
+      })
+    case WriteOpAction.Update:
+      return com.atproto.repo.applyWrites.updateResult.$build({
+        cid: write.cid.toString(),
+        uri: write.uri.toString(),
+        validationStatus: write.validationStatus,
+      })
+    case WriteOpAction.Delete:
+      return com.atproto.repo.applyWrites.deleteResult.$build({})
+    default:
+      throw new Error(`Unrecognized action: ${write}`)
+  }
+}
+
+/**
+ * The genesis commit of a folder that does not exist yet, computed in memory: an empty tree
+ * plus the initial creates. Nothing about the folder exists on this host until the device has
+ * signed this and `createFolder` has run.
+ */
+export const unsignedGenesis = async (
+  did: DidString,
+  writes: PreparedCreate[],
+): Promise<UnsignedCommitWithOps> => {
+  const unsigned = await Repo.formatUnsignedInitCommit(
+    new MemoryBlockstore(),
+    did,
+    writes.map(createWriteToOp),
+  )
+  return {
+    ...unsigned,
+    ops: writes.map((w) => ({
+      action: 'create' as const,
+      path: formatDataKey(w.uri.collection, w.uri.rkey),
+      cid: w.cid,
+    })),
+    prevData: null,
+  }
+}
+
+/**
+ * Whether a folder for this DID may be made on this host: the DID document, read fresh from
+ * the directory, must point its `atproto_pds` service at this host and name a signing key and a
+ * handle; no account for the DID may exist here; the handle must be valid by this host's own
+ * rules and free. Returns the handle and the signing key the document names.
+ */
+export const assertFolderCanBeMadeHere = async (
+  ctx: AppContext,
+  did: DidString,
+): Promise<{ handle: HandleString; signingKey: string }> => {
+  const doc = await ctx.idResolver.did.resolve(did, true)
+  if (!doc) {
+    throw new InvalidRequestError(
+      `Could not resolve DID document for ${did}`,
+      'IncompatibleDidDoc',
+    )
+  }
+  let data
+  try {
+    data = ensureAtpDocument(doc)
+  } catch {
+    throw new InvalidRequestError(
+      'DID document must name a signing key, a handle and a host',
+      'IncompatibleDidDoc',
+    )
+  }
+  if (data.pds !== ctx.cfg.service.publicUrl) {
+    throw new InvalidRequestError(
+      `DID document points its atproto_pds service at ${data.pds}, not at this host (${ctx.cfg.service.publicUrl})`,
+      'IncompatibleDidDoc',
+    )
+  }
+  const existing = await ctx.accountManager.getAccount(did, {
+    includeDeactivated: true,
+    includeTakenDown: true,
+  })
+  if (existing) {
+    throw new InvalidRequestError(
+      `An account for ${did} already exists on this host`,
+      'AlreadyExists',
+    )
+  }
+  const handle = await ctx.accountManager.normalizeAndValidateHandle(
+    data.handle,
+    { did },
+  )
+  if (await ctx.accountManager.getAccount(handle)) {
+    throw new InvalidRequestError(
+      `Handle already taken: ${handle}`,
+      'HandleTaken',
+    )
+  }
+  return { handle, signingKey: data.signingKey }
+}
+
+/**
+ * Create the folder around a genesis commit the device signed: the actor store with no key
+ * file, the repo, the account row (no email, no password, no session), and the sequencer's
+ * account-creation events. Rolled back in reverse if any step fails, as upstream's
+ * createAccount does.
+ */
+export const createFolder = async (
+  ctx: AppContext,
+  did: DidString,
+  handle: HandleString,
+  writes: PreparedCreate[],
+  rev: string,
+  sig: Uint8Array,
+  didKey: string,
+): Promise<CommitDataWithOps> => {
+  await ctx.actorStore.create(did)
+  try {
+    const commit = await ctx.actorStore.transact(did, (actorTxn) =>
+      actorTxn.repo.createRepoFromDeviceSigned(writes, rev, sig, didKey),
+    )
+    await ctx.accountManager.createAccount({
+      did,
+      handle,
+      repoCid: commit.cid,
+      repoRev: commit.rev,
+      deactivated: false,
+    })
+    try {
+      await ctx.sequencer.sequenceAccountCreation(did, handle, commit)
+    } catch (err) {
+      await ctx.accountManager.deleteAccount(did)
+      throw err
+    }
+    return commit
+  } catch (err) {
+    await ctx.actorStore.destroy(did)
+    throw err
+  }
+}
+
+/**
+ * Run a device-signed step with the DID document's current signing key. If the signature
+ * fails against the cached key, the document is read again from the directory once, in case
+ * the device rotated its key, and the step is retried with the fresh key if it changed.
+ */
+export const withDeviceKey = async <T>(
+  ctx: AppContext,
+  did: DidString,
+  attempt: (didKey: string) => Promise<T>,
+): Promise<T> => {
+  const key = await ctx.idResolver.did.resolveAtprotoKey(did)
+  try {
+    return await attempt(key)
+  } catch (err) {
+    if (err instanceof BadCommitSignatureError) {
+      const fresh = await ctx.idResolver.did.resolveAtprotoKey(did, true)
+      if (fresh !== key) {
+        return attempt(fresh)
+      }
+    }
+    throw err
+  }
+}
+
+/** The transactor's refusals, as the errors the lexicons name. */
+export const asRequestError = (err: unknown): never => {
+  if (err instanceof BadCommitSwapError) {
+    throw new InvalidRequestError(err.message, 'InvalidSwap')
+  }
+  if (err instanceof BadCommitRevError) {
+    throw new InvalidRequestError(err.message, 'InvalidRev')
+  }
+  if (err instanceof BadCommitSignatureError) {
+    throw new InvalidRequestError(err.message, 'InvalidSignature')
+  }
+  throw err
+}
