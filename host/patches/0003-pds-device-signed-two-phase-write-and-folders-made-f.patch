+{
+  "lexicon": 1,
+  "id": "foundation.forest.host.submitCommit",
+  "defs": {
+    "main": {
+      "type": "procedure",
+      "description": "Phase two of a device-signed write. The host rebuilds the commit prepareCommit described, from the same writes and the same rev, checks the signature against the signing key in the DID document, checks the commit builds on the current head, and stores it. Nothing is kept between the two phases. When the DID has no folder on this host yet, this is the genesis commit and the folder is created around it: no email, no password, no session, and no key file, ever. Implemented by a Forest host.",
+      "input": {
+        "encoding": "application/json",
+        "schema": {
+          "type": "object",
+          "required": ["writes", "rev", "sig"],
+          "properties": {
+            "validate": { "type": "boolean" },
+            "writes": {
+              "type": "array",
+              "description": "The writes prepareCommit returned, record keys included.",
+              "items": {
+                "type": "union",
+                "refs": [
+                  "com.atproto.repo.applyWrites#create",
+                  "com.atproto.repo.applyWrites#update",
+                  "com.atproto.repo.applyWrites#delete"
+                ],
+                "closed": true
+              }
+            },
+            "swapCommit": {
+              "type": "string",
+              "format": "cid",
+              "description": "The prev prepareCommit returned. If provided, fails with InvalidSwap unless it is still the folder's current commit. Omit for a genesis."
+            },
+            "rev": {
+              "type": "string",
+              "format": "tid",
+              "description": "The rev prepareCommit returned. Must be newer than the current head's, which is what makes a replay fail."
+            },
+            "sig": {
+              "type": "bytes",
+              "description": "The folder's signing key's signature over the unsignedCommit bytes prepareCommit returned.",
+              "maxLength": 256
+            }
+          }
+        }
+      },
+      "output": {
+        "encoding": "application/json",
+        "schema": {
+          "type": "object",
+          "required": ["commit", "results"],
+          "properties": {
+            "commit": { "type": "ref", "ref": "com.atproto.repo.defs#commitMeta" },
+            "results": {
+              "type": "array",
+              "items": {
+                "type": "union",
+                "refs": [
+                  "com.atproto.repo.applyWrites#createResult",
+                  "com.atproto.repo.applyWrites#updateResult",
+                  "com.atproto.repo.applyWrites#deleteResult"
+                ],
+                "closed": true
+              }
+            }
+          }
+        }
+      },
+      "errors": [
+        {
+          "name": "InvalidSwap",
+          "description": "The swapCommit did not match the folder's current commit: the head moved. Prepare again."
+        },
+        {
+          "name": "InvalidRev",
+          "description": "The rev is not a TID newer than the current head's. A commit already stored, replayed, fails here."
+        },
+        {
+          "name": "InvalidSignature",
+          "description": "The signature does not verify, against the DID document's current signing key, over the commit the host rebuilt. Either another key signed, or the head moved and the rebuilt commit is not the one that was signed: prepare again."
+        },
+        {
+          "name": "IncompatibleDidDoc",
+          "description": "No folder can be made here for this DID: its document does not point its atproto_pds service at this host, names no handle, or names no signing key."
+        },
+        {
+          "name": "HandleTaken",
+          "description": "The handle the DID document names already belongs to another folder on this host."
+        }
+      ]
+    }
+  }
+}
