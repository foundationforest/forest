# Jetstream (jetstream-legacy's cmd/jetstream, pinned in UPSTREAM). Copy to jetstream.env.
# Every variable here is Jetstream's own; nothing is added.

# The relay's stream, which it reads and turns into JSON.
JETSTREAM_WS_URL=ws://localhost:2470/xrpc/com.atproto.sync.subscribeRepos

# Where indexes subscribe: ws://<host>:6008/subscribe?wantedCollections=foundation.forest.*
JETSTREAM_LISTEN_ADDR=:6008
JETSTREAM_METRICS_LISTEN_ADDR=:6009

# Its own store of recent events, for replay by cursor.
JETSTREAM_DATA_DIR=data/jetstream
JETSTREAM_EVENT_TTL=24h

# Jetstream exits when no new event has arrived for this long, expecting to be restarted, and
# trims its store on the same clock. The default, 15s, suits Bluesky's whole network, not a new
# one: a quiet hour would restart it every 15 seconds.
JETSTREAM_LIVENESS_TTL=24h
