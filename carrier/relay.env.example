# The relay (indigo's cmd/relay, pinned in UPSTREAM). Copy to relay.env and set the secret.
# Every variable here is the relay's own; nothing is added.

# Admin endpoints (adding a host, limits, bans) take it as HTTP basic auth, user "admin". Never commit it.
RELAY_ADMIN_PASSWORD=replace-me

# Only the hosts an admin adds: public requestCrawl is refused (403), so no host joins by asking.
RELAY_DISABLE_REQUEST_CRAWL=true

# Where DIDs are resolved, to check every commit's signature against its DID document.
RELAY_PLC_HOST=https://plc.directory

# Plain SQLite and a folder of event files. On Railway: both on one volume, or Postgres for the
# database (postgres://...).
DATABASE_URL=sqlite://data/relay/relay.sqlite
RELAY_PERSIST_DIR=data/relay/persist
# How far back a subscriber can ask to replay.
RELAY_REPLAY_WINDOW=72h

RELAY_API_BIND=:2470
RELAY_METRICS_LISTEN=:2471

# Strict sync checks stay on (RELAY_LENIENT_SYNC_VALIDATION unset): a commit whose history does not
# follow from the last one is refused, not passed on with a log line.
