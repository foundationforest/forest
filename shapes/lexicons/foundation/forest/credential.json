{
  "lexicon": 1,
  "id": "foundation.forest.credential",
  "defs": {
    "main": {
      "type": "record",
      "description": "One copy of a W3C verifiable credential, held by the profile it was issued to.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["issuer", "credential", "createdAt"],
        "properties": {
          "issuer": {
            "type": "string",
            "description": "The issuer's DID.",
            "format": "did"
          },
          "credential": {
            "type": "unknown",
            "description": "The verifiable credential as issued, unchanged."
          },
          "createdAt": {
            "type": "string",
            "description": "When this copy was stored.",
            "format": "datetime"
          }
        }
      }
    }
  }
}
