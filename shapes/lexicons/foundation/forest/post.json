{
  "lexicon": 1,
  "id": "foundation.forest.post",
  "defs": {
    "main": {
      "type": "record",
      "description": "An offer or a request in one market.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["direction", "market", "role", "description", "price", "remote", "createdAt"],
        "properties": {
          "direction": {
            "type": "string",
            "description": "Offering something, or asking for it.",
            "enum": ["offer", "request"]
          },
          "market": {
            "type": "string",
            "description": "Standard market name from the markets directory.",
            "maxLength": 64
          },
          "role": {
            "type": "string",
            "description": "The poster's role, one of the market file's roles.",
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxGraphemes": 3000,
            "maxLength": 30000
          },
          "price": {
            "type": "ref",
            "ref": "#price"
          },
          "terms": {
            "type": "ref",
            "ref": "#terms"
          },
          "availability": {
            "type": "string",
            "description": "When, in the poster's words.",
            "maxGraphemes": 500,
            "maxLength": 5000
          },
          "remote": {
            "type": "boolean",
            "description": "True when the work happens online."
          },
          "location": {
            "type": "string",
            "description": "Where, when not remote.",
            "maxGraphemes": 128,
            "maxLength": 1280
          },
          "expires": {
            "type": "string",
            "description": "Optional. After this the post is stale.",
            "format": "datetime"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "price": {
      "type": "object",
      "description": "The price block. Per hour, per day, per job: the app multiplies before funding, one escrow per payment.",
      "required": ["amount", "mint", "per"],
      "properties": {
        "amount": {
          "type": "string",
          "description": "Amount in whole units of the token, as decimal text: \"25\", \"12.50\".",
          "maxLength": 32
        },
        "mint": {
          "type": "string",
          "description": "The token, named by its mint's address on Solana, base58. Any classic token; which tokens an index weighs is the index's call.",
          "minLength": 32,
          "maxLength": 44
        },
        "per": {
          "type": "string",
          "description": "What one amount buys.",
          "enum": ["hour", "day", "job"]
        }
      }
    },
    "terms": {
      "type": "object",
      "description": "Optional. The options an escrow made from this post is created with, each off unless set. Absent or empty: no arbiter and no timer.",
      "properties": {
        "arbiter": {
          "type": "string",
          "description": "Optional. A Solana key, base58, that may decide any split. Absent: no arbiter.",
          "minLength": 32,
          "maxLength": 44
        },
        "timer": {
          "type": "ref",
          "ref": "#timer"
        }
      }
    },
    "timer": {
      "type": "object",
      "description": "Optional. This many days after funding, everything goes to the named side. The only clock an escrow has.",
      "required": ["days", "to"],
      "properties": {
        "days": {
          "type": "integer",
          "description": "Whole days from funding.",
          "minimum": 1,
          "maximum": 65535
        },
        "to": {
          "type": "string",
          "description": "The side that gets everything when the timer ends.",
          "enum": ["seller", "buyer"]
        }
      }
    }
  }
}
