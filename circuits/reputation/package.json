{
  "name": "@forest/reputation",
  "version": "0.0.0",
  "private": true,
  "description": "The reputation proof: a count-weighted score from up to eight of a person's own profiles in an index's tree, for one main key, naming none of them. The circuit, its devnet setup, and the client an index and an app use.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "fetch": "node scripts/fetch.ts",
    "compile": "node scripts/compile.ts",
    "check": "tsc --noEmit",
    "test": "node --test --test-force-exit test/reputation.test.ts"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@semaphore-protocol/group": "4.12.1",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@zk-kit/binary-merkle-root.circom": "2.0.0",
    "circomlib": "2.0.5",
    "typescript": "5.9.3"
  }
}
